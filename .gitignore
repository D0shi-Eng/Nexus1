# =============================================================================
# NEXUS — قواعد استبعاد النشر
# الغاية: منع دخول أي مخرج مُولَّد، أو بيانات مستخدم محلية، أو مادة سرّية إلى
# المستودع المنشور. القاعدة الحاكمة: المصدر فقط يُنشر.
# لا يُضاف استثناء (!) إلا لملف مصدر مطلوب فعلاً، مع تعليل في السطر نفسه.
# =============================================================================

# --- مخرجات البناء المُولَّدة: تُبنى محلياً ولا تُنشر أبداً ---
node_modules/
dist/
target/
.build-tmp/
.tmp-build/
apps/desktop/src-tauri/gen/

# --- حزم Tauri والمثبّتات والتنفيذيات والمكتبات المولَّدة ---
*.exe
*.msi
*.msix
*.appx
*.dll
*.dylib
*.so
*.pdb
*.lib
*.rlib
*.rmeta
*.nsis
*.nupkg

# --- ملفات مؤقتة ومسوّدات ---
*.tmp
*.temp
*.partial
*.swp
*.swo
*~
.tmp-*
tmp/
*.hold

# --- قواعد بيانات محلية أو اختبارية: بيانات المستخدم الحقيقية لا تُنشر ---
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# --- سجلات وتشخيص وانهيارات ---
*.log
*.dmp
*.mdmp
*.stackdump
*.err

# --- تغطية الاختبار والكاش وحالة البناء التدريجية ---
coverage/
.nyc_output/
*.lcov
*.tsbuildinfo
.eslintcache
.cache/
.vite/
.turbo/
.nx/

# --- لقطات الشاشة والمخرجات المولَّدة أثناء التحقق ---
# مُقيَّدة بشجرتَي الأدلة عن قصد: قاعدة *.png عامة قد تُخفي أصلاً مصدرياً مطلوباً
# في assets/ أو icons/، وهو أسوأ من ترك لقطة زائدة.
audit/**/*.png
phases/**/*.png
**/screenshots/
# الاستثناء الوحيد المقصود: لقطات التطبيق الحقيقية المتحقَّق منها للتوثيق العام
# (بيانات ديمو تركيبية فقط، بلا أي بيانات مستخدم أو أسرار — راجع CONTRIBUTING §11).
!docs/images/screenshots/
!docs/images/screenshots/*.png

# --- مخرجات جولات UAT الخام (تقارير تشغيل CSV/MD): تبقى على القرص ولا تُنشر ---
audit/uat-*/
audit/visual-verification/

# --- مسبارات ونتائج المراحل والتدقيق: مخرجات خام وليست مصدراً ---
phases/**/tools/
phases/**/*.ps1
phases/**/*.txt
audit/**/*.ps1
audit/**/*.py
audit/**/*.txt
audit/**/*.json

# --- نسخة استرجاع مصدرية قديمة: مُدرَجة في J وتُستبعد من النشر مع إبقائها على القرص ---
audit/recovery-backup-2026-08-16/

# --- سكربتات ترقيع لمرة واحدة: أُدرجت في J ولا تُنشر ---
scripts_tmp_patch_*

# --- بيئة ومفاتيح توقيع وشهادات ---
.env
.env.*
# صيغ شائعة لملف بيئة محلي لا يبدأ بنقطة، مثل secrets.env.local
*.env
*.env.*
*.pfx
*.p12
*.pem
*.key
*.jks
*.keystore
*.snk
*.cer
*.crt
*.der
# مفاتيح SSH بلا امتداد: أسماء قياسية لا يكشفها أي نمط امتدادي
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
*.mobileprovision
*.provisionprofile
.npmrc
.netrc
_netrc
secrets.json
secrets.yaml
secrets.yml
secrets.toml
*.secret
*.secrets

# --- نسخ احتياطية وأرشيفات ---
*.nxbackup
*.bak
*.orig
*.rej
# حزم NSIS والمثبّتات المضغوطة تُبنى في target/ وتُوزَّع خارج المستودع
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# --- حالة المحررات ونظام التشغيل ---
.vscode/
.idea/
.history/
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# =============================================================================
# جولة الإغلاق النهائي — قواعد فصل الوثائق الداخلية (2026-10-18)
# -----------------------------------------------------------------------------
# هذه المجلدات أرشيف عمل داخلي (تقارير مراحل، جولات تدقيق، أدلة UAT خام،
# جرد جودة) وليست لازمة لفهم المنتج أو بناءه أو اختباره أو المساهمة فيه.
# أُبقيت على القرص وفي تاريخ Git، واستُبعدت من HEAD ومن أي إضافة مستقبلية.
# =============================================================================
/phases/
/audit/
/docs/delivery/
/docs/audit/
/docs/quality/
PROJECT_STATE.md
PROJECT_DISCOVERY.md

# --- جولة 19 أكتوبر 2026: أدلة تدقيق خام وتقارير هندسية داخلية لا تُنشر ---
# ملفان يحتويان عدّادات داخلية ومسارات/بصمات تشغيلية للمالك، وتقريران مرحليان
# قديمان (16 أغسطس 2026) لا يعكسان حالة V1. تبقى على القرص وفي تاريخ Git.
/docs/security/GIT_HISTORY_AND_SECRET_AUDIT.md
/docs/security/PUBLIC_RELEASE_CONTENT_REVIEW.md
/docs/operations/mvp-scope-status.md
/docs/operations/verification-report-2026-08-16.md
# ولا تُضاف لقطات بحث خارجية أو مستندات مورّد منسوخة إلى الشجرة المنشورة.
/*_docs/

# مخرجات/مسبارات توليد العلامة التجارية (ليست مصدراً)
assets/branding/build-report.txt
assets/branding/PREVIEW.md

# نسخة استرجاع/احتياط داخل جذر المشروع (تبقى على القرص ولا تُنشر)
/recovery-backup-*/
.baseline/

# فجوات اكتُشفت في تدقيق الإصدار
*.p7b
.envrc
*.db.backup-*
*.db.qa-backup-*
*.db.bak
**/evidence/

# المسودات القانونية غير المعتمدة (EULA/خصوصية/ترخيص تجاري/بوابات مالك) لا تُنشر.
# يُتتبَّع فقط جرد التراخيص ومراجعتها لأنها إشعارات توزيع مطلوبة.
/docs/legal/*
!/docs/legal/THIRD_PARTY_LICENSE_REVIEW.md
!/docs/legal/THIRD_PARTY_LICENSE_INVENTORY.md
